# 複製成 .env 後填入實際值。.env 已被 .gitignore 排除，不會進版控。

# --- 資料庫（對應 docker-compose.yml 的 db 服務）---
DATABASE_URL="postgresql://nearbite:nearbite@localhost:5432/nearbite?schema=public"
# 若本機 5432 已被占用，改這個值並同步修改 DATABASE_URL 的 port
DB_PORT=5432

# --- Auth.js（Google OAuth）---
# 產生方式：openssl rand -base64 32
AUTH_SECRET=""
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID（Web application）
# 授權重新導向 URI：http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# 允許登入的 email 白名單，逗號分隔，不分大小寫，例如 "me@gmail.com, friend@gmail.com"
# 正式環境必填：為空時正式環境會拒絕所有登入（避免忘了設定就對全世界開放）；
# 開發環境為空時允許任何 Google 帳號登入，方便本機測試
ALLOWED_EMAILS=""

# --- Google Maps Platform ---
# 伺服器端使用（Places API (New)、Geocoding API）。限制：API restrictions 只開這兩個 API
GOOGLE_MAPS_SERVER_API_KEY=""
# 瀏覽器端使用（Maps JavaScript API）。限制：HTTP referrer 限定 localhost 與正式網域
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=""
