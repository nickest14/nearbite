# 複製成 .env 後填入實際值。.env 已被 .gitignore 排除，不會進版控。

# --- 資料庫（對應 docker-compose.yml 的 db 服務）---
DATABASE_URL="postgresql://nearbite:nearbite@localhost:5432/nearbite?schema=public"
# 若本機 5432 已被占用，改這個值並同步修改 DATABASE_URL 的 port
DB_PORT=5432

# --- Auth.js（Google OAuth）---
# 產生方式：openssl rand -base64 32
AUTH_SECRET=""
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID（Web application）
# 授權重新導向 URI：http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# 允許登入的 email 白名單，逗號分隔，不分大小寫，例如 "me@gmail.com, friend@gmail.com"
# 正式環境必填：為空時正式環境會拒絕所有登入（避免忘了設定就對全世界開放）；
# 開發環境為空時允許任何 Google 帳號登入，方便本機測試
ALLOWED_EMAILS=""

# --- Google Maps Platform（設定步驟見 README 的「Google Maps Platform 設定」）---
# 伺服器端金鑰：只在 Server Action 讀取，不會送到瀏覽器。
# Cloud Console 的限制：Application restrictions 選 None（Server Action 沒有 referrer）；
# API restrictions 只勾 Places API (New) 與 Geocoding API
GOOGLE_MAPS_SERVER_API_KEY=""
# 瀏覽器端金鑰：會內嵌進前端 bundle，任何人都看得到，所以一定要設限制。
# Application restrictions 選 Websites，加入 http://localhost:3000/* 與正式網域；
# API restrictions 只勾 Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=""
# 地圖樣式的 Map ID（AdvancedMarker 需要）。開發時可留空，程式會用 Google 提供的 DEMO_MAP_ID；
# 正式環境到 Google Maps Platform → Map Management 建一個再填進來
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""
